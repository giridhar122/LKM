# ==============================================================================
# LKM SmartDesk - Environment Configuration
# ==============================================================================

PROJECT_NAME="LKM SmartDesk"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# --- Security & JWT ---
SECRET_KEY="lkm_smartdesk_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (MySQL 8.0) ---
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="lkm_smartdesk"
# Set to True if MySQL credentials are not yet configured or for offline testing
USE_SQLITE_FALLBACK=False

# --- Google Gemini AI API ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_CONFIDENCE_THRESHOLD=0.75

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="lkm_smartdesk_webhook_verify_token_2026"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_SIMULATION_MODE=True

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ENABLED=True
TELEGRAM_POLLING_MODE=True

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
